<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keeps the installation id out of Auto Backup and device transfer, so a restored or
         cloned device never shares another device's id. -->
    <application
        android:dataExtractionRules="@xml/pushpilot_data_extraction_rules"
        android:fullBackupContent="@xml/pushpilot_backup_rules"
        tools:targetApi="31" />
</manifest>
